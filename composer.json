{
    "name": "anun333/oe-module-layout-export",
    "description": "Export OpenEMR's layout forms and lists to files you can keep in version control, compare a file with a site or with another file, and read the SQL files the old backup.php page wrote, without running them",
    "type": "openemr-module",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "openemr",
        "openemr-module",
        "layouts",
        "lists",
        "forms",
        "backup",
        "version-control"
    ],
    "authors": [
        {
            "name": "anun333",
            "email": "anun333@posteo.net"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-zip": "*",
        "ext-zlib": "*",
        "openemr/oe-module-installer-plugin": "^0.1.5",
        "anun333/openhealthcare-common": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "OpenHealthcare\\LayoutExport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenHealthcare\\LayoutExport\\Tests\\": "tests/"
        },
        "files": [
            "tests/stubs.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "openemr/oe-module-installer-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/anun333/oe-module-layout-export/issues",
        "source": "https://github.com/anun333/oe-module-layout-export"
    }
}
